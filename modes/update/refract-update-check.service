[Unit]
Description=Check for Refract OS updates
Documentation=https://github.com/Mr-Pythoneer/refract-os
# Only meaningful with a network; failing quietly beats a red unit in the journal.
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/refract-update-check
# The notification waits for a click so it can OPEN the updater, which means one
# process has to outlive ExecStart. With the default KillMode=control-group
# systemd tears that process down the instant the script returns — which is why
# clicking the notification had never done anything, and why the notification
# itself was at risk of being withdrawn before anyone saw it. KillMode=process
# stops systemd at the main process and leaves the waiter running.
KillMode=process
# A failed check is not an error worth reporting to the user: the machine may
# simply be offline. distro-update itself distinguishes "up to date" from
# "could not check", and the GUI shows the difference.
SuccessExitStatus=0 1
