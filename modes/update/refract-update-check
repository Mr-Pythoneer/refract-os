#!/bin/sh
# Background update check -> one desktop notification, at most once per new build.
#
# Runs as the USER (a user systemd timer), never as root: checking needs no
# privilege, and a root timer that pops notifications into somebody's session is
# a worse design than a user timer that cannot change the system at all.
#
# NOTIFY ONCE PER BUILD, not once per check. A daily nag about the same update is
# how people learn to ignore update notifications entirely. The commit that was
# last advertised is remembered, and a repeat is silent.
set -u

STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/refract/last-notified-commit"
command -v distro-update >/dev/null 2>&1 || exit 0

out="$(distro-update check 2>&1)"; rc=$?
[ "$rc" -eq 10 ] || exit 0   # 0 = current, 1 = could not check; neither is news

# `check` writes the top-bar marker itself, so by this point the Refract menu
# already shows "Update available" whether or not the notification below is seen
# or dismissed. The notification is the nudge; the menu is the durable state.

# "Update available: <old> -> <new>" — the new commit is the last field.
newest="$(printf '%s' "$out" | sed -n 's/.*-> *\([0-9a-f]\{6,\}\).*/\1/p' | tail -n1)"
[ -n "$newest" ] || newest="$(printf '%s' "$out" | tr -d '\n')"

[ -r "$STAMP" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$newest" ] && exit 0

mkdir -p "$(dirname "$STAMP")"
printf '%s\n' "$newest" > "$STAMP"

# CLICKING IT NOW ACTUALLY OPENS THE APP. It never did before, twice over:
# nothing read the action back, and `notify-send --action` BLOCKS until the
# notification is clicked or dismissed — so backgrounding it and exiting let
# systemd tear the whole cgroup down a second later, killing the very process
# that was waiting. A notification whose only instruction is "go find an app in
# the grid" is not much better than no notification.
#
# The subshell below outlives this script; refract-update-check.service sets
# KillMode=process so systemd leaves it alone. Worst case, if the wait is cut
# short anyway, the notification has already been delivered over D-Bus and the
# behaviour is exactly what it was before — visible, just not clickable.
(
    act="$(notify-send --app-name="Refract" --icon=software-update-available \
        --hint=string:desktop-entry:refract-updates \
        --action="open=Install now" \
        "Refract update available" \
        "A newer build of Refract is ready. Click to open Refract Updates." 2>/dev/null)"
    case "$act" in
        open|default) setsid /usr/local/bin/refract-updates >/dev/null 2>&1 & ;;
    esac
) >/dev/null 2>&1 &

exit 0
