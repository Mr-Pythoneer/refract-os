#!/usr/bin/env bash
# distro-update — bring Refract's OWN code up to date, without reinstalling.
#
# WHY THIS EXISTS. Everything that makes this Refract rather than Ubuntu —
# /opt/distro, the distro-* CLIs, the mode profiles, the layouts, the GNOME
# top-bar switcher — is copied in from the ISO at install time. There is no apt
# repo and no PPA, so before this existed the only way to get a fix onto an
# installed machine was to download a new ISO, flash it and reinstall. Nobody
# reinstalls their operating system to get a bug fix.
#
# WHAT IT DOES NOT TOUCH: apt. Ubuntu packages, security updates and
# applications remain the job of GNOME Software, update-manager and
# unattended-upgrades. This handles exactly the Refract layer, which is the part
# with no other delivery mechanism. Keeping those two separate means an update
# here can never break the system's ability to receive security patches.
#
# HOW "BEHIND" IS DECIDED. iso/build.sh records the commit it was built from in
# /etc/refract/build-id. This compares that against the head of the repo's
# default branch. The ISO is built from that branch, so it is the honest
# comparison — when tagged releases exist, switch REMOTE_REF to the tag and the
# rest of this script is unchanged.
set -uo pipefail

REPO_SLUG="${REFRACT_REPO:-Mr-Pythoneer/refract-os}"
REMOTE_REF="${REFRACT_CHANNEL:-main}"
# Overridable (mirrors REFRACT_REPO/REFRACT_CHANNEL above, and distro-modectl's
# GOV_AVAIL_FILE/ENABLED_MODES_FILE) so a test can point `check` at a fixture
# build-id and exercise both the up-to-date and update-available branches
# without needing a real installed system.
BUILD_ID_FILE="${REFRACT_BUILD_ID_FILE:-/etc/refract/build-id}"
STATE_DIR="/var/lib/refract"
INSTALL_ROOT="/opt/distro"
BIN_DIR="/usr/local/bin"
EXT_DIR="/usr/share/gnome-shell/extensions"
# Same paths iso/build.sh installs to, so `apply` converges an installed machine
# on what a fresh install of the same commit would have.
DESKTOP_DIR="/usr/share/applications"
USER_UNIT_DIR="/usr/lib/systemd/user"
SYSTEM_UNIT_DIR="/usr/lib/systemd/system"
UDEV_DIR="/usr/lib/udev/rules.d"

# ------------------------------------------------------------------- SIGNING
# The Ed25519 public key every image carries. Its private half exists only as a
# GitHub Actions secret and signs the manifest in .github/workflows/sign-layer.yml.
#
# THIS PATH IS LOCAL AND IS NEVER FETCHED. That is the entire point: a key
# downloaded from the same channel as the payload proves nothing, because
# whoever can replace one can replace the other.
PUBKEY="${REFRACT_PUBKEY:-/usr/share/refract/refract-signing.pub}"
LAYER_BASE="${REFRACT_LAYER_BASE:-https://github.com/${REPO_SLUG}/releases/download/layer-latest}"

have_pubkey() { [ -s "$PUBKEY" ] && command -v openssl >/dev/null 2>&1; }

# ------------------------------------------------------- WHY IT FAILED, EXACTLY
# The update check is a chain of five things that can each fail on their own:
# DNS, github.com, the release asset, the signature, and the signature being
# VALID. The first version of this reported all five — plus "GitHub answered but
# rate-limited us" — with the single sentence "Could not reach GitHub to check
# for updates", which is the one cause the user can do nothing about and is
# usually the wrong one. A machine whose signature verification is failing would
# be told its wifi is broken, forever.
#
# WHY A FILE AND NOT A VARIABLE. remote_commit and fetch_verified_manifest are
# both called inside $( ), so they run in a subshell — a variable set in there
# is gone by the time the caller reads it. The filesystem is the only channel
# that crosses that boundary, and this is short-lived state, not persisted state.
REASON_FILE="$(mktemp -t refract-update-reason.XXXXXX 2>/dev/null || echo /tmp/refract-update-reason.$$)"
trap 'rm -f "$REASON_FILE"' EXIT
why() { printf '%s\n' "$*" > "$REASON_FILE" 2>/dev/null || true; }
last_why() { cat "$REASON_FILE" 2>/dev/null; }

# Fetch manifest + signature, verify, print the manifest. Non-zero on ANY doubt.
#
# FAIL CLOSED, EVERY BRANCH. A verifier that returns success when it could not
# reach the signature, or when openssl is missing, is not a verifier — it is a
# delay before installing whatever arrived. The one permitted "unverified" path
# is have_pubkey() being false, which is decided by the CALLER and announced.
fetch_verified_manifest() {  # fetch_verified_manifest <workdir>
    local w="$1"
    curl -fsSL --max-time 30 "$LAYER_BASE/refract-layer.manifest"     -o "$w/m"   2>/dev/null || {
        why "could not download the update manifest from GitHub Releases.
Note that release files are served from objects.githubusercontent.com, NOT
github.com — some school, office and hotel networks allow one and block the
other, which looks exactly like this."
        return 1; }
    curl -fsSL --max-time 30 "$LAYER_BASE/refract-layer.manifest.sig" -o "$w/m.sig" 2>/dev/null || {
        why "the manifest downloaded but its signature did not. The release may
be half-published — this usually fixes itself within a few minutes."
        return 1; }
    [ -s "$w/m" ] && [ -s "$w/m.sig" ] || {
        why "the manifest or its signature downloaded as an empty file. That is
usually a captive portal (hotel/airport/school wifi) answering instead of
GitHub. Open a browser, accept the network's login page, and try again."
        return 1; }
    # -rawin is REQUIRED for Ed25519: it signs the message itself rather than a
    # pre-computed digest, and without the flag openssl errors out rather than
    # verifying — which would look like a bad signature on a good file.
    openssl pkeyutl -verify -rawin -pubin -inkey "$PUBKEY" \
        -sigfile "$w/m.sig" -in "$w/m" >/dev/null 2>&1 || {
        # NOT a network problem, and saying "check your connection" here would
        # send somebody to reboot their router over a security event.
        why "the update manifest downloaded fine, but its signature is NOT valid
for this machine's key. Either this build predates the current signing key, or
something on the network altered the file. Refusing it is the correct outcome.
Run: distro-update diagnose"
        return 1; }
    cat "$w/m"
}

manifest_field() { printf '%s\n' "$2" | awk -v k="$1" '$1==k {print $2; exit}'; }

C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_DIM=$'\033[36m'; C_OFF=$'\033[0m'

die() { echo "${C_ERR}distro-update: $*${C_OFF}" >&2; exit 1; }
note() { echo "${C_DIM}$*${C_OFF}"; }

usage() {
    cat <<'USAGE'
distro-update — update Refract's own components (not Ubuntu packages).

  distro-update check      is a newer build available? (no changes made)
  distro-update apply      download and install it (needs root)
  distro-update notes      what changed, in plain language
  distro-update status     what this machine is running
  distro-update diagnose   why a failing update check is failing
  distro-update -h         this text

Ubuntu packages, security updates and apps are handled by GNOME Software /
Software Updater / unattended-upgrades. This only updates the Refract layer:
/opt/distro, the distro-* commands, mode profiles, layouts and the GNOME
top-bar extension.
USAGE
}

installed_commit() {
    [ -r "$BUILD_ID_FILE" ] || { echo unknown; return; }
    # shellcheck disable=SC1090
    ( . "$BUILD_ID_FILE" 2>/dev/null; printf '%s' "${REFRACT_COMMIT:-unknown}" )
}

remote_commit() {
    # PREFER THE SIGNED MANIFEST. Taking the "what is the latest version"
    # answer from an unauthenticated API means whoever controls that response
    # can also pin a machine at an old build by answering with its current
    # commit — a downgrade/freeze attack that needs no ability to forge code at
    # all. When a key is present the answer comes from bytes we can verify.
    if have_pubkey; then
        local w m
        w="$(mktemp -d)" || return 1
        m="$(fetch_verified_manifest "$w")"; rm -rf "$w"
        [ -n "$m" ] && { manifest_field commit "$m"; return 0; }
        return 1
    fi
    # No key yet (an install that predates signing). Legacy path.
    local body sha
    body="$(curl -fsSL --max-time 20 \
        "https://api.github.com/repos/${REPO_SLUG}/commits/${REMOTE_REF}" 2>/dev/null)" || {
        why "could not reach api.github.com. This build predates update signing,
so it has to ask the API instead of reading a signed manifest."
        return 1; }
    sha="$(printf '%s' "$body" \
        | sed -n 's/.*"sha"[[:space:]]*:[[:space:]]*"\([0-9a-f]\{40\}\)".*/\1/p' | head -n1)"
    if [ -z "$sha" ]; then
        # GitHub's unauthenticated API allows 60 requests an hour PER IP. On a
        # shared network — a school, an office, anywhere behind one NAT — that
        # budget is routinely spent by somebody else entirely, and the reply is
        # a perfectly successful HTTP response containing an error message. It
        # is not a connection failure, and telling somebody to check their wifi
        # when their wifi is fine is how a bug report goes nowhere for a week.
        case "$body" in
            *"rate limit"*|*"API rate"*)
                why "GitHub's API rate limit for this network is used up (60 requests
an hour, shared by everyone on the same connection). Your network is fine — wait
an hour, or update to a signed build, which does not use the API at all." ;;
            *) why "GitHub answered, but not with anything this could read." ;;
        esac
        return 1
    fi
    printf '%s\n' "$sha"
}

short() { printf '%.12s' "$1"; }

# ------------------------------------------------------------------ WHAT'S NEW
# A dev's note, in plain language, shown every time an update lands.
#
# WHY NOT COMMIT MESSAGES. This repo's commits are long and written for whoever
# has to maintain the thing — file paths, exit codes, the reasoning behind a
# tradeoff. Dumping that on someone who clicked "Install Update" answers a
# question they did not ask. WHATS-NEW.md is the same changes described to the
# person living with them.
#
# WHY DATES AND NOT COMMITS. An entry cannot name the commit it lands in — the
# hash does not exist until after the file is written. Dates can be written by
# hand and compared against something the machine already records: build.sh
# stamps REFRACT_BUILT into /etc/refract/build-id, and `apply` stamps
# STATE_DIR/last-update. The newer of those two is "what this machine has already
# seen", which is exactly the cutoff wanted.
NOTES_FILE="WHATS-NEW.md"
NOTES_SHOWN="$STATE_DIR/last-notes"
# The heading of the newest entry this machine has been shown. This is the real
# cursor; see notes_new for why a date could never be one.
NOTES_MARKER="$STATE_DIR/last-note-id"

# YYYY-MM-DD of the newest thing this machine has already got. Empty => unknown,
# and the caller shows nothing rather than dumping the entire file at someone.
seen_date() {
    local built="" updated=""
    # shellcheck disable=SC1090
    [ -r "$BUILD_ID_FILE" ] && built="$( . "$BUILD_ID_FILE" 2>/dev/null; printf '%s' "${REFRACT_BUILT:-}" )"
    [ -r "$STATE_DIR/last-update" ] && updated="$(cat "$STATE_DIR/last-update" 2>/dev/null)"
    built="${built:0:10}"; updated="${updated:0:10}"
    # String comparison is correct here and only here: ISO-8601 dates sort
    # lexicographically, which is the entire reason for using that format.
    if [ -n "$updated" ] && { [ -z "$built" ] || [[ "$updated" > "$built" ]]; }; then
        printf '%s\n' "$updated"
    else
        printf '%s\n' "$built"
    fi
}

# Entries from a WHATS-NEW.md on stdin that this machine has not been shown.
#
# A DATE ALONE IS NOT ENOUGH, and using one was a bug. Entries are dated by day,
# but several builds can ship in one day — and they do. With a strict "newer than
# my build date" test, a machine built on the 16th sees nothing from an update
# shipped later on the 16th, which is precisely the first update anyone takes.
# With a >= test instead, every subsequent run re-shows the same entries forever,
# because after updating the machine's own date IS that date.
#
# So the real cursor is the last HEADING shown, not a date. The file is
# newest-first, so "print from the top until you reach what you already saw" is
# exact regardless of how many entries share a day. The date is kept only as the
# fallback for a machine that has never been shown anything — and there it is
# inclusive (>=), so the same-day case works on the first run too.
notes_new() {
    local cutoff="$1" marker="${2:-}"
    awk -v cutoff="$cutoff" -v marker="$marker" '
        /^## / {
            if (marker != "") {
                if ($0 == marker) exit
            } else if (cutoff != "" && substr($2, 1, 10) < cutoff) {
                exit
            }
            seen_first = 1
        }
        # Everything above the first heading is the file preamble, never an entry.
        seen_first { print }
    '
}

fetch_notes() {
    curl -fsSL --max-time 20 \
        "https://raw.githubusercontent.com/${REPO_SLUG}/${REMOTE_REF}/${NOTES_FILE}" 2>/dev/null
}

cmd_notes() {
    local cutoff marker body
    cutoff="$(seen_date)"
    marker=""; [ -r "$NOTES_MARKER" ] && marker="$(cat "$NOTES_MARKER" 2>/dev/null)"
    body="$(fetch_notes)" || body=""
    if [ -z "$body" ]; then
        echo "${C_WARN}Could not fetch the release notes.${C_OFF}" >&2
        # Fall back to whatever the last update showed — offline is a normal
        # state and the notes for the build you are running are still useful.
        [ -r "$NOTES_SHOWN" ] && { echo; cat "$NOTES_SHOWN"; return 0; }
        return 1
    fi
    body="$(printf '%s\n' "$body" | notes_new "$cutoff" "$marker")"
    if [ -z "$body" ]; then
        # Not an error, and not silence either — "you are up to date with the
        # notes" is a different answer from "something went wrong".
        echo "${C_OK}Nothing new since your build.${C_OFF}"
        [ -r "$NOTES_SHOWN" ] && { echo; echo "${C_DIM}Last time, this changed:${C_OFF}"; cat "$NOTES_SHOWN"; }
        return 0
    fi
    printf '%s\n' "$body"
    return 0
}

# THE MARKER FILE — how a non-terminal user ever learns an update exists.
#
# Every check path (this CLI, the Refract Updates window, the daily user timer)
# ends up calling `check`, so writing the answer here means one place keeps it
# current. The GNOME top-bar extension watches this file and shows an "Update
# available" item when it appears — that is the whole discoverability story, and
# it costs the shell no network calls and no polling.
#
# Per-user, never root: it lives in the user's XDG state dir, and `check` needs
# no privilege. A root check (`sudo distro-update check`) writes root's copy,
# which nothing reads and nothing is harmed by.
marker_for_home() { printf '%s\n' "$1/.local/state/refract/update-available"; }
update_marker() {
    if [ -n "${XDG_STATE_HOME:-}" ]; then
        printf '%s\n' "$XDG_STATE_HOME/refract/update-available"
    else
        marker_for_home "${HOME:-/root}"
    fi
}
mark_update() {  # mark_update <commit> | mark_update ""  (empty clears it)
    local m; m="$(update_marker)"
    if [ -z "$1" ]; then rm -f "$m" 2>/dev/null || true; return 0; fi
    mkdir -p "$(dirname "$m")" 2>/dev/null || return 0
    printf '%s\n' "$1" > "$m" 2>/dev/null || true
}
# After a successful `apply` (which runs as root) the marker belongs to whoever
# asked for the update, not to root. Resolve them the same two ways
# distro-modectl does — sudo sets SUDO_USER, the GUI's pkexec sets PKEXEC_UID.
clear_marker_for_invoker() {
    local u="" home=""
    [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] && u="$SUDO_USER"
    [ -z "$u" ] && [ -n "${PKEXEC_UID:-}" ] && [ "$PKEXEC_UID" != 0 ] && u="$(id -un "$PKEXEC_UID" 2>/dev/null || true)"
    if [ -n "$u" ]; then
        home="$(getent passwd "$u" 2>/dev/null | cut -d: -f6)" || home=""
        [ -n "$home" ] && rm -f "$(marker_for_home "$home")" 2>/dev/null || true
    fi
    mark_update ""
}

cmd_status() {
    local ic; ic="$(installed_commit)"
    echo "Refract build:  $(short "$ic")"
    # shellcheck disable=SC1090  # runtime path, not resolvable statically
    [ -r "$BUILD_ID_FILE" ] && { . "$BUILD_ID_FILE" 2>/dev/null; \
        echo "Strain:         ${REFRACT_STRAIN:-unknown}"; \
        echo "Built:          ${REFRACT_BUILT:-unknown}"; }
    [ -r "$STATE_DIR/last-update" ] && echo "Last updated:   $(cat "$STATE_DIR/last-update")"
    echo "Channel:        ${REPO_SLUG}@${REMOTE_REF}"
}

# Exit codes are the interface the GUI and the timer rely on:
#   0 = up to date, 10 = update available, 1 = could not tell (offline, etc).
# A network failure must NEVER read as "up to date" — that is how a machine sits
# quietly out of date for months.
cmd_check() {
    local ic rc
    ic="$(installed_commit)"
    rc="$(remote_commit)"
    if [ -z "$rc" ]; then
        # DELIBERATELY leaves the marker alone. "Could not check" is not
        # "up to date", and clearing the top-bar notice on a single failed
        # lookup would make a real pending update disappear because the wifi
        # dropped for thirty seconds.
        local r; r="$(last_why)"
        echo "${C_WARN}Could not check for updates.${C_OFF}" >&2
        if [ -n "$r" ]; then printf '%s\n' "$r" >&2
        else echo "No reason was recorded. Run: distro-update diagnose" >&2; fi
        return 1
    fi
    if [ "$ic" = "unknown" ]; then
        echo "${C_WARN}This build recorded no commit, so it cannot be compared.${C_OFF}" >&2
        echo "Latest available: $(short "$rc")"
        mark_update "$rc"
        return 10
    fi
    if [ "$ic" = "$rc" ]; then
        mark_update ""
        echo "${C_OK}Refract is up to date ($(short "$ic")).${C_OFF}"
        return 0
    fi
    mark_update "$rc"
    echo "Update available: $(short "$ic") -> $(short "$rc")"
    return 10
}

cmd_apply() {
    [ "$(id -u)" -eq 0 ] || die "'apply' needs root — try: sudo distro-update apply"

    # DON'T LET THE MACHINE SUSPEND MID-UPDATE. Downloading a layer and rsyncing
    # it over /opt/distro takes minutes on a slow link, and an idle timer does
    # not know that. Suspend drops every TCP connection, so an unattended update
    # could be interrupted partway through replacing the system's own tooling —
    # the worst possible moment. systemd-inhibit re-executes this command holding
    # a sleep+idle lock that GNOME's automatic suspend honours; the lock is
    # released when the process exits, including on failure.
    #
    # Re-exec ONCE. The marker stops an infinite loop if systemd-inhibit is
    # present but the lock cannot be taken.
    if [ -z "${_REFRACT_INHIBITED:-}" ] && command -v systemd-inhibit >/dev/null 2>&1; then
        export _REFRACT_INHIBITED=1
        exec systemd-inhibit --what=sleep:idle --who="Refract" \
             --why="Installing a Refract update" "$0" apply
    fi
    command -v curl >/dev/null 2>&1 || die "curl is required"
    command -v rsync >/dev/null 2>&1 || die "rsync is required"
    command -v tar >/dev/null 2>&1 || die "tar is required"

    local rc; rc="$(remote_commit)"
    [ -n "$rc" ] || die "could not reach GitHub — check the network and try again"

    # CAPTURED BEFORE ANYTHING IS WRITTEN. The cutoff is derived from build-id
    # and last-update, and this function overwrites both — read it afterwards and
    # it is always "now", so every note is filtered out and the user is told
    # nothing changed on the one occasion they most want to know what did.
    local notes_cutoff; notes_cutoff="$(seen_date)"

    local work; work="$(mktemp -d)" || die "could not create a temp dir"
    # shellcheck disable=SC2064
    # Cleans the reason file too: this REPLACES the EXIT trap set at the top of
    # the script, so not naming it here would leak one temp file per apply.
    trap "rm -rf '$work'; rm -f '$REASON_FILE'" EXIT INT TERM

    if have_pubkey; then
        # THE VERIFIED PATH. Nothing is extracted until the manifest's signature
        # checks out against the key that shipped with this machine AND the
        # tarball's digest matches what that signed manifest says it should be.
        # Both, in that order: a valid signature over a manifest for a different
        # tarball is exactly what an attacker who can swap only the payload
        # would produce.
        note "Downloading the signed layer..."
        local mani
        mani="$(fetch_verified_manifest "$work")" \
            || die "the update's signature did not verify — REFUSING to install it.
  Nothing has been changed. This means the downloaded update was not published by
  this project's signing key: either something on the network altered it, or the
  release is broken. Do not work around this."
        local want_sha got_sha
        want_sha="$(manifest_field sha256 "$mani")"
        [ -n "$want_sha" ] || die "the signed manifest carries no digest — refusing to install"

        curl -fsSL --max-time 300 "$LAYER_BASE/refract-layer.tar.gz" -o "$work/src.tgz" \
            || die "download failed — nothing has been changed"
        got_sha="$(sha256sum "$work/src.tgz" 2>/dev/null | cut -d" " -f1)"
        [ -n "$got_sha" ] || die "could not hash the download — refusing to install"
        [ "$got_sha" = "$want_sha" ] \
            || die "the download does not match its signed manifest — REFUSING to install.
  expected $want_sha
  got      $got_sha
  Nothing has been changed."

        mkdir -p "$work/x"
        tar -xzf "$work/src.tgz" -C "$work/x" \
            || die "the download was corrupt — nothing has been changed"
        note "Signature verified."
    else
        # NO KEY ON THIS MACHINE. Installed before signing existed, so there is
        # nothing to verify against and the key itself has to arrive somehow.
        # This is the one unverified install, it is announced, and the update it
        # performs is what makes every subsequent one verified. Refusing here
        # instead would strand every existing install on the unsigned path
        # forever, which is not more secure — it is the same risk, permanently.
        echo "${C_WARN}This machine has no Refract signing key yet, so this update cannot be" >&2
        echo "verified. It is the update that installs the key; every update after it" >&2
        echo "will be checked. If you are on an untrusted network, wait until you are not.${C_OFF}" >&2
        note "Downloading ${REPO_SLUG}@$(short "$rc")..."
        if ! curl -fsSL --max-time 300 \
                "https://codeload.github.com/${REPO_SLUG}/tar.gz/${rc}" -o "$work/src.tgz"; then
            die "download failed — nothing has been changed"
        fi
        mkdir -p "$work/x"
        tar -xzf "$work/src.tgz" -C "$work/x" --strip-components=1 \
            || die "the download was corrupt — nothing has been changed"
    fi

    # Sanity-check the payload BEFORE touching the installed system. A truncated
    # or unexpected tarball must not be allowed to half-replace /opt/distro.
    [ -d "$work/x/modes" ] && [ -d "$work/x/drivers" ] \
        || die "downloaded tree has no modes/ or drivers/ — refusing to install it"
    [ -x "$work/x/modes/modectl/distro-modectl" ] \
        || die "downloaded tree has no distro-modectl — refusing to install it"

    # RE-APPLY MODE OMISSION BEFORE THE RSYNC.
    #
    # An image built with REFRACT_OMIT_MODES=ai has had modes/ai deleted, its
    # profile removed and distro-modectl's ALL_MODES=() rewritten — the design
    # calls that "provably absent", not merely hidden. rsync of the whole
    # upstream tree undoes every part of that: it recreates /opt/distro/modes/ai,
    # recreates profiles/ai.conf, restores the stock distro-modectl with all five
    # modes in ALL_MODES, and the symlink refresh below then puts distro-ai-* back
    # on PATH. An update would silently reinstall the thing the build deliberately
    # left out, on a machine chosen for not having it.
    # DETECTED FROM DISK, not from a recorded flag. Omission happens two
    # different ways — iso/build.sh strips modes at BUILD time under
    # REFRACT_OMIT_MODES, and distro-apply-mode-selection strips them at INSTALL
    # time from what was ticked in the installer — and only one of those could
    # ever write a build-id field. What is actually missing under /opt/distro is
    # true for both, needs no new state, and cannot drift out of sync with
    # reality the way a stamp can.
    local omitted="" m
    for m in gaming ai server creative; do
        [ -d "$INSTALL_ROOT/modes/$m" ] || omitted="$omitted $m"
    done
    omitted="$(echo "$omitted" | xargs)"

    note "Updating ${INSTALL_ROOT}..."
    mkdir -p "$INSTALL_ROOT"
    rsync -a --delete "$work/x/modes" "$work/x/drivers" "$INSTALL_ROOT/" \
        || die "failed to update ${INSTALL_ROOT}"

    if [ -n "$omitted" ]; then
        local kept=""
        for m in gaming ai server creative normal; do
            case " $omitted " in *" $m "*) continue ;; esac
            kept="$kept $m"
        done
        for m in $omitted; do
            case "$m" in *[!a-z]*|"") continue ;; esac   # never rm -rf on junk
            rm -rf "${INSTALL_ROOT:?}/modes/$m"
            rm -f  "${INSTALL_ROOT:?}/modes/modectl/profiles/$m.conf"
            rm -f  "$BIN_DIR/distro-$m"-*
        done
        # Same edit iso/build.sh makes to the shipped copy, re-applied to the one
        # that was just downloaded.
        sed -i "s/^ALL_MODES=(.*/ALL_MODES=($(echo "$kept" | xargs))/" \
            "$INSTALL_ROOT/modes/modectl/distro-modectl" 2>/dev/null || true
        note "Kept this build mode-omitted: $(echo "$omitted" | xargs) removed again."
    fi

    # Refresh the CLI symlinks: a new release may add or remove commands, and a
    # dangling link to a script that no longer exists is worse than a missing one.
    note "Refreshing commands in ${BIN_DIR}..."
    local f name
    for f in "$BIN_DIR"/distro-*; do
        [ -L "$f" ] || continue
        [ -e "$f" ] || rm -f "$f"
    done
    # refract-* AS WELL AS distro-*. This looked only for distro-*, so a NEW
    # refract-named app could never reach an updated machine: apply installed
    # Refract Tips' .desktop, which points at /usr/local/bin/refract-tips, and
    # then never created that symlink — an app-grid icon that launches nothing.
    # refract-monitor and refract-updates survived only because iso/build.sh made
    # their symlinks at INSTALL time, so the gap was invisible until an app was
    # added after an image shipped. Which is the whole point of an updater.
    #
    # __pycache__ is excluded explicitly: py_compile leaves
    # refract-monitor.cpython-*.pyc next to the script, and it matches
    # refract-*. Symlinking a bytecode file into PATH would put a "command" there
    # that does nothing when run.
    while IFS= read -r -d '' f; do
        name="$(basename "$f")"
        chmod +x "$f" 2>/dev/null || true
        ln -sfn "$f" "$BIN_DIR/$name"
    done < <(find "$INSTALL_ROOT/modes" "$INSTALL_ROOT/drivers" -type f \
                  \( -name 'distro-*' -o -name 'refract-*' \) \
                  ! -name '*.pyc' ! -name '*.desktop' ! -name '*.service' ! -name '*.timer' \
                  ! -path '*/__pycache__/*' -print0 2>/dev/null)

    # WHATS-NEW.md, so the notes outlive the terminal they were printed in.
    # Refract Tips reads this copy for its "What's new" page — the update history
    # is the answer to "what changed and when", and having it exist only in the
    # scrollback of whoever ran the update is not an answer.
    if [ -f "$work/x/$NOTES_FILE" ]; then
        mkdir -p /usr/share/refract
        install -m 0644 "$work/x/$NOTES_FILE" "/usr/share/refract/$NOTES_FILE" || true
    fi

    # THE KEY ITSELF. Without this step the trust-on-first-use bootstrap never
    # completes: a machine with no key would take an unverified update forever,
    # every time, because nothing would ever put a key on it.
    if [ -f "$work/x/iso/keys/refract-signing.pub" ]; then
        mkdir -p "$(dirname "$PUBKEY")"
        install -m 0644 "$work/x/iso/keys/refract-signing.pub" "$PUBKEY" \
            && note "Installed the update signing key — future updates will be verified."
    fi

    # The GNOME top-bar extension ships in the repo too, so it updates here.
    if [ -d "$work/x/iso/gnome-extensions" ]; then
        note "Updating GNOME Shell extensions..."
        mkdir -p "$EXT_DIR"
        rsync -a "$work/x/iso/gnome-extensions/" "$EXT_DIR/" || true
    fi

    # LAUNCHERS AND THE UPDATE TIMER.
    #
    # Until this existed, `apply` refreshed /opt/distro and the distro-* symlinks
    # and nothing else — so the updater could fix any COMMAND it shipped, but
    # never the app-grid launcher, the desktop notification or the timer that are
    # the only ways somebody who doesn't use a terminal ever reaches it. An
    # improvement to how updates are DELIVERED was therefore reachable only by
    # flashing a new ISO and reinstalling, which is precisely the thing this
    # whole module exists to make unnecessary. That is a bootstrapping hole, not
    # a missing feature: the delivery mechanism could not deliver itself.
    #
    # Same destinations iso/build.sh uses, so an updated machine and a freshly
    # installed one end up byte-identical.
    note "Refreshing launchers and the update timer..."
    mkdir -p "$DESKTOP_DIR"
    local d dmode
    for d in "$work"/x/modes/*/*.desktop; do
        [ -f "$d" ] || continue
        # Same omission guard iso/build.sh applies. $omitted was computed above
        # from what is actually missing under /opt/distro, so a machine built
        # without gaming never gets distro-exe.desktop — a registered handler for
        # .exe files whose binary this machine does not have would be worse than
        # no handler at all.
        dmode="${d#"$work"/x/modes/}"; dmode="${dmode%%/*}"
        case " $omitted " in *" $dmode "*) continue ;; esac
        install -m 0644 "$d" "$DESKTOP_DIR/$(basename "$d")" || true
    done
    # Only touch systemd's user units on a system that actually has them; a
    # server/cloud strain with no graphical session has no use for either.
    if [ -d "$USER_UNIT_DIR" ]; then
        local u
        for u in "$work"/x/modes/update/*.service "$work"/x/modes/update/*.timer; do
            [ -f "$u" ] || continue
            install -m 0644 "$u" "$USER_UNIT_DIR/$(basename "$u")" || true
        done
        if [ -f "$USER_UNIT_DIR/refract-update-check.timer" ]; then
            mkdir -p "$USER_UNIT_DIR/timers.target.wants"
            ln -sfn ../refract-update-check.timer \
                "$USER_UNIT_DIR/timers.target.wants/refract-update-check.timer" || true
        fi
    fi
    # Without this the app grid keeps serving the cached copy and a changed
    # name, icon or set of search keywords simply never appears — and, since
    # distro-exe.desktop, the MimeType= lines that make a .exe openable at all
    # do nothing until they are compiled into mimeinfo.cache.
    command -v update-desktop-database >/dev/null 2>&1 \
        && update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true

    # SYSTEM UNITS AND UDEV RULES, by convention: modes/<m>/systemd/system/*
    # and modes/<m>/udev/*.rules. Same reasoning as the launchers above — a
    # feature that needs a unit (battery-aware power switching) or a udev rule
    # could otherwise only ever reach a machine by reinstalling it.
    #
    # UNITS ARE COPIED, BUT ONLY refract-* ARE ENABLED. Copying a unit file is
    # inert; enabling one starts running code at boot, and auto-enabling
    # whatever happens to be in the tree would be a much bigger promise than
    # "update Refract's own layer". Refract's units are all named refract-*, so
    # that prefix is the boundary, and only units that actually declare an
    # [Install] section are touched.
    local u name
    local -a to_enable=()
    if [ -d "$SYSTEM_UNIT_DIR" ]; then
        for u in "$work"/x/modes/*/systemd/system/*; do
            [ -f "$u" ] || continue
            name="$(basename "$u")"
            install -m 0644 "$u" "$SYSTEM_UNIT_DIR/$name" || continue
            case "$name" in
                refract-*) grep -q '^\[Install\]' "$u" && to_enable+=("$name") ;;
            esac
        done
    fi
    if [ -d "$USER_UNIT_DIR" ]; then
        for u in "$work"/x/modes/*/systemd/user/*; do
            [ -f "$u" ] || continue
            install -m 0644 "$u" "$USER_UNIT_DIR/$(basename "$u")" || true
        done
    fi
    # dconf DROP-INS. Only the numbered files this project owns outright and
    # never edits after install — 00-refract is DELIBERATELY EXCLUDED, because
    # shellprocess_cleanup rewrites it on the installed system to swap the
    # installer's dock pin for GNOME Software. Reinstalling a pristine copy here
    # would put an "Install Refract OS" icon back on the dock of a machine that
    # is already installed, which is the exact bug that file was written to fix.
    if [ -d /etc/dconf/db/local.d ]; then
        local d changed_dconf=0
        for d in "$work"/x/iso/branding/dconf/local.d/[1-9]*-refract*; do
            [ -f "$d" ] || continue
            install -m 0644 "$d" "/etc/dconf/db/local.d/$(basename "$d")" && changed_dconf=1
        done
        # The compiled binary db is what GNOME reads; editing the text without
        # recompiling changes nothing at all.
        [ "$changed_dconf" = 1 ] && command -v dconf >/dev/null 2>&1 \
            && dconf update >/dev/null 2>&1 || true
    fi

    # FIRST-LOGIN AUTOSTART, system-wide. iso/build.sh puts these in
    # /etc/skel/.config/autostart, which is copied only when a user is CREATED —
    # so on a machine that took an update, the person already sitting at it never
    # gets the entry and Refract Tips never appears. /etc/xdg/autostart applies to
    # every user, existing ones included, and each of these scripts already
    # stamps a per-user file so it still runs exactly once per person.
    if [ -d /etc/xdg/autostart ]; then
        for u in "$work"/x/modes/*/firstlogin/*.desktop; do
            [ -f "$u" ] || continue
            install -m 0644 "$u" "/etc/xdg/autostart/$(basename "$u")" || true
        done
    fi
    if [ -d "$UDEV_DIR" ]; then
        for u in "$work"/x/modes/*/udev/*.rules; do
            [ -f "$u" ] || continue
            install -m 0644 "$u" "$UDEV_DIR/$(basename "$u")" || true
        done
        command -v udevadm >/dev/null 2>&1 && udevadm control --reload >/dev/null 2>&1 || true
    fi
    # RELOAD FIRST, THEN ENABLE. `systemctl enable` resolves [Install] through
    # the running manager, so enabling a unit systemd has not re-read yet can
    # fail on a brand-new unit file — which is exactly the case here, every time.
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        for name in ${to_enable[@]+"${to_enable[@]}"}; do
            systemctl enable "$name" >/dev/null 2>&1 \
                || echo "note: could not enable $name" >&2
        done
    fi

    # Keep the app grid at one entry per job. This is re-run on every update and
    # not just at install time, because the set of duplicates is not static: a
    # release that adds a Refract tool for something Ubuntu also ships would
    # otherwise put a second icon on every already-installed machine, reachable
    # only by reinstalling. Idempotent, and `distro-appgrid restore` undoes it.
    if [ -x "$INSTALL_ROOT/modes/appgrid/distro-appgrid" ]; then
        note "Checking the app grid for duplicate launchers..."
        "$INSTALL_ROOT/modes/appgrid/distro-appgrid" dedupe || true
    fi

    mkdir -p "$STATE_DIR" "$(dirname "$BUILD_ID_FILE")"
    # Record the new commit so `check` stops reporting an update, and stamp when.
    { echo "REFRACT_COMMIT=${rc}"
      # shellcheck disable=SC1090
      [ -r "$BUILD_ID_FILE" ] && ( . "$BUILD_ID_FILE" 2>/dev/null
          echo "REFRACT_STRAIN=${REFRACT_STRAIN:-unknown}"
          echo "REFRACT_BUILT=${REFRACT_BUILT:-unknown}" )
    } > "$BUILD_ID_FILE.new" && mv "$BUILD_ID_FILE.new" "$BUILD_ID_FILE"
    date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE_DIR/last-update"
    # The top-bar notice and the "update available" state are stale by
    # definition now. Clear them for whoever asked, not for root.
    clear_marker_for_invoker

    echo "${C_OK}Refract updated to $(short "$rc").${C_OFF}"
    echo "Log out and back in for a new top-bar extension or layout to take effect."

    # WHAT ACTUALLY CHANGED. Read from the tree that was just downloaded, not
    # re-fetched over the network: it is already on disk, it is guaranteed to be
    # the version that was installed, and an update that succeeded should not be
    # able to fail at the last step because a second HTTP request timed out.
    local notes="" notes_marker=""
    [ -r "$NOTES_MARKER" ] && notes_marker="$(cat "$NOTES_MARKER" 2>/dev/null)"
    [ -f "$work/x/$NOTES_FILE" ] && notes="$(notes_new "$notes_cutoff" "$notes_marker" < "$work/x/$NOTES_FILE")"
    if [ -n "$notes" ]; then
        echo
        echo "${C_DIM}──────────────────────────── what changed ────────────────────────────${C_OFF}"
        printf '%s\n' "$notes"
        echo "${C_DIM}──────────────────────────────────────────────────────────────────────${C_OFF}"
        # Kept so the Refract Updates window can show the same text, and so
        # `distro-update notes` still works on a machine that is now offline.
        mkdir -p "$STATE_DIR" 2>/dev/null || true
        printf '%s\n' "$notes" > "$NOTES_SHOWN" 2>/dev/null || true
        # Advance the cursor to the newest heading just shown, so the next
        # update starts from here and nothing is ever repeated.
        printf '%s\n' "$notes" | grep -m1 '^## ' > "$NOTES_MARKER" 2>/dev/null || true
    fi
}

# ------------------------------------------------------------------- DIAGNOSE
# Walks the chain one hop at a time and says which hop is broken.
#
# WHY THIS IS WORTH ITS OWN COMMAND. "It can't connect to GitHub" is true of a
# dead DNS server, a captive portal, a blocked CDN host, a half-published
# release and a bad signature — five different problems with five different
# fixes, and no way to tell them apart from the outside. Every one of them
# previously produced the same sentence. This prints the chain so the answer is
# visible rather than inferred.
cmd_diagnose() {
    local ok=0 w
    hop() {  # hop <label> <command...>
        printf '  %-38s' "$1"; shift
        if "$@" >/dev/null 2>&1; then echo "${C_OK}ok${C_OFF}"; return 0
        else echo "${C_ERR}FAILED${C_OFF}"; ok=1; return 1; fi
    }
    echo "Update channel: ${REPO_SLUG}@${REMOTE_REF}"
    echo "Release assets: $LAYER_BASE"
    echo
    echo "Network:"
    # Split by HOST, because the release assets are NOT served from github.com.
    # A network that permits github.com and blocks the asset CDN is common and
    # is invisible unless the two are tested separately.
    hop "DNS: github.com"                 getent hosts github.com
    hop "DNS: objects.githubusercontent.com" getent hosts objects.githubusercontent.com
    hop "HTTPS: github.com"               curl -fsS --max-time 15 -o /dev/null https://github.com
    echo
    echo "Update files:"
    w="$(mktemp -d)" || return 1
    hop "manifest downloads"     curl -fsSL --max-time 30 "$LAYER_BASE/refract-layer.manifest"     -o "$w/m"
    hop "signature downloads"    curl -fsSL --max-time 30 "$LAYER_BASE/refract-layer.manifest.sig" -o "$w/m.sig"
    echo
    echo "Signing:"
    if [ -s "$PUBKEY" ]; then
        echo "  ${C_OK}public key present${C_OFF}  $PUBKEY"
        # The fingerprint is what tells a stale build apart from a tampered
        # file: both fail verification, and only this distinguishes them.
        command -v openssl >/dev/null 2>&1 && \
            echo "  fingerprint            $(openssl pkey -pubin -in "$PUBKEY" -outform DER 2>/dev/null | md5sum | cut -c1-32)"
    else
        echo "  ${C_WARN}no public key — this build predates signing and uses the GitHub API${C_OFF}"
    fi
    hop "openssl available"  command -v openssl
    if [ -s "$w/m" ] && [ -s "$w/m.sig" ] && [ -s "$PUBKEY" ]; then
        hop "signature is valid" openssl pkeyutl -verify -rawin -pubin -inkey "$PUBKEY" \
            -sigfile "$w/m.sig" -in "$w/m"
    fi
    echo
    echo "Versions:"
    echo "  installed              $(installed_commit)"
    [ -s "$w/m" ] && echo "  available              $(manifest_field commit "$(cat "$w/m")")"
    rm -rf "$w"
    echo
    if [ "$ok" -eq 0 ]; then
        echo "${C_OK}Everything the updater needs is working.${C_OFF}"
    else
        echo "${C_WARN}The first FAILED line above is the problem — the ones after it${C_OFF}"
        echo "${C_WARN}usually fail only because it did.${C_OFF}"
    fi
    return "$ok"
}

# Sourceable, like distro-modectl (DISTRO_MODECTL_SOURCE=1), so tests can call
# the REAL functions instead of trying to carve them out of this file with sed.
# That is not a hypothetical convenience: the signing test's first version did
# extract them with two overlapping sed ranges, which duplicated every line of
# fetch_verified_manifest and ran manifest_field's range to the end of the file
# — producing something that returned 0 for a tampered signature and passed.
if [ "${DISTRO_UPDATE_SOURCE:-}" = "1" ]; then
    return 0 2>/dev/null || true
fi

case "${1:-}" in
    check)              cmd_check ;;
    apply)              cmd_apply ;;
    notes)              cmd_notes ;;
    status)             cmd_status ;;
    diagnose)           cmd_diagnose ;;
    -h|--help|help|"")  usage ;;
    *)                  die "unknown command '$1' (try --help)" ;;
esac
