def _markup(text):
    """The small subset of Markdown these notes use, as Pango markup.

    ESCAPE FIRST, THEN ADD TAGS. The other order lets an & or a < in a note —
    a URL with a query string, say — close or corrupt a tag, and Pango does not
    render a broken string, it renders NOTHING. A note that silently vanishes is
    worse than one with a stray asterisk in it.
    """
    out = GLib.markup_escape_text(text)
    out = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", out, flags=re.S)
    out = re.sub(r"`([^`]+)`", r"<tt>\1</tt>", out)
    return out


def read_whats_new():
    """[(heading, body)] newest-first, or [] if the file is not installed."""
    raw = ""
    for path in _WHATS_NEW_FALLBACKS:
        try:
            with open(path, "r", encoding="utf-8") as f:
                raw = f.read()
            break
        except OSError:
            continue
    if not raw:
        return []
    entries = []
    heading, body = None, []
    for line in raw.splitlines():
        if line.startswith("## "):
            if heading:
                entries.append((heading, "\n".join(body).strip()))
            heading, body = line[3:].strip(), []
        elif heading is not None:
            body.append(line)
    if heading:
        entries.append((heading, "\n".join(body).strip()))
    return entries


def _exists(argv):
    if not argv:
        return False
    exe = argv[0]
    if "/" in exe:
        return os.path.exists(exe)
    return GLib.find_program_in_path(exe) is not None


class TipsWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Refract Tips")
        self.set_default_size(820, 660)

        self.stack = Adw.ViewStack()
        for key, title, icon, groups in PAGES:
            self.stack.add_titled_with_icon(self._build(groups), key, title, icon)
        self.stack.add_titled_with_icon(self._build_whats_new(), "whatsnew",
                                        "What's new", "software-update-available-symbolic")

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.ViewSwitcher(stack=self.stack,
                                                 policy=Adw.ViewSwitcherPolicy.WIDE))
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(self.stack)
        toolbar.add_bottom_bar(Adw.ViewSwitcherBar(stack=self.stack, reveal=False))
        self.set_content(toolbar)

        # Seen. Written on OPEN rather than on close, so a window someone opened
        # and immediately dismissed does not come back at every login.
        try:
            os.makedirs(os.path.dirname(STAMP), exist_ok=True)
            with open(STAMP, "w") as f:
                f.write("seen\n")
        except OSError:
            pass

    def _build(self, groups):
        page = Adw.PreferencesPage()
        for gtitle, rows in groups:
            group = Adw.PreferencesGroup(title=gtitle)
            for title, subtitle, action in rows:
                row = Adw.ActionRow(title=title, subtitle=subtitle)
                row.set_subtitle_lines(0)     # wrap, never ellipsise a whole tip
                row.set_title_lines(0)
                if action and _exists(action[1]):
                    btn = Gtk.Button(label=action[0], valign=Gtk.Align.CENTER)
                    btn.add_css_class("pill")
                    btn.connect("clicked", self._launch, action[1])
                    row.add_suffix(btn)
                group.add(row)
            page.add(group)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        page.set_vexpand(True)
        box.append(page)
        return box

    def _build_whats_new(self):
        """Every past update note, newest first, each one collapsed to its title.

        ExpanderRow rather than a wall of text: after a few months this is dozens
        of entries, and the question being asked is almost always "when did X
        change", which is answered by scanning titles. Opening one is the
        follow-up, not the first move.
        """
        page = Adw.PreferencesPage()
        entries = read_whats_new()
        if not entries:
            group = Adw.PreferencesGroup(title="What's new")
            row = Adw.ActionRow(
                title="No update history on this system yet",
                subtitle="It arrives with the first update, and is kept at "
                         + WHATS_NEW + ".",
            )
            row.set_subtitle_lines(0)
            group.add(row)
            page.add(group)
        else:
            group = Adw.PreferencesGroup(
                title="What's new",
                description="Every change to Refract, newest first. The same notes "
                            "shown when an update installs.",
            )
            for heading, body in entries:
                exp = Adw.ExpanderRow(title=GLib.markup_escape_text(heading))
                exp.set_title_lines(0)
                label = Gtk.Label(
                    label=_markup(body),
                    use_markup=True,
                    wrap=True,
                    xalign=0.0,
                    selectable=True,
                    margin_top=8, margin_bottom=12, margin_start=12, margin_end=12,
                )
                # A note is prose, not a form field: the row's own layout would
                # centre and ellipsise it.
                holder = Adw.ActionRow(activatable=False)
                holder.set_child(label)
                exp.add_row(holder)
                group.add(exp)
            page.add(group)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        page.set_vexpand(True)
        box.append(page)
        return box

    def _launch(self, _btn, argv):
        try:
            Gio.Subprocess.new(argv, Gio.SubprocessFlags.NONE)
        except GLib.Error as e:
            dlg = Adw.MessageDialog(transient_for=self, heading="Could not start it",
                                    body=str(e))
            dlg.add_response("ok", "OK")
            dlg.connect("response", lambda d, _r: d.destroy())
            dlg.present()


class TipsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.add_main_option("first-run", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
                             "Only open if these tips have never been shown", None)
        self.add_main_option("whats-new", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
                             "Open on the update history", None)

    def do_command_line(self, cmdline):
        opts = cmdline.get_options_dict()
        # --first-run is what the autostart entry passes. Exiting quietly when
        # the stamp exists is the whole mechanism: no timer, no dconf key, and
        # deleting one file brings the tips back for anyone who wants them.
        if opts.contains("first-run") and os.path.exists(STAMP):
            return 0
        self.activate()
        if opts.contains("whats-new"):
            win = self.props.active_window
            if win:
                win.stack.set_visible_child_name("whatsnew")
        return 0

    def do_activate(self):
        win = self.props.active_window or TipsWindow(self)
        win.present()


if __name__ == "__main__":
    sys.exit(TipsApp().run(sys.argv))
