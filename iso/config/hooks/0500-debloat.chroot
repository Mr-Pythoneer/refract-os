#!/bin/sh
# Refract OS debloat — remove what this distro provably never uses.
#
# Driven by a MEASURED report, not vibes: verify-boot-fixes' bloat step lists the
# shipped image's largest packages straight out of its own dpkg status. The
# classic Ubuntu app bloat is already absent (thunderbird, libreoffice,
# rhythmbox, cheese, shotwell, the four GNOME games, simple-scan,
# popularity-contest all confirmed missing). What remained was Canonical's
# service layer plus assets this distro replaced but never removed.
#
# EVERY purge here is GUARDED. apt-get purge happily takes reverse-dependencies
# with it, and a wrong guess ships an image with no desktop — the exact class of
# silent, catastrophic breakage this project has already been bitten by. So each
# candidate is SIMULATED first, and skipped if apt reports it would also remove
# anything on the protect list. A skipped package logs loudly and stays.
set -e

# Anything whose removal would break boot, login, graphics, networking or the
# installer. If a purge would take one of these, the purge is refused.
# NOTE: the desktop METApackages (ubuntu-desktop-minimal, lubuntu-desktop) are
# deliberately NOT guarded. They hold dependencies and nothing else — losing one
# removes no actual software, and guarding them would block every purge below,
# since the metapackage depends on firefox, yaru-theme-icon and so on. What must
# survive is the real components, which is what this list protects.
GUARD='^(gnome-shell|gdm3|nautilus|ubuntu-session|xserver-xorg-core|network-manager|casper|calamares|plymouth|systemd|dbus|linux-image-.*|linux-modules-.*|mesa-.*|libgl1.*|libglx-.*|libegl1.*)$'

purged_kb=0
# Snapshot before touching anything, so the post-purge check below knows whether
# this strain is even supposed to have a desktop (server/cloud legitimately do not).
HAD_DESKTOP=""
[ -x /usr/bin/gnome-shell ] && HAD_DESKTOP=1
try_purge() {
    for p in "$@"; do
        dpkg -s "$p" >/dev/null 2>&1 || continue
        # Simulate. apt prints `Purg <pkg>` for packages it will PURGE and
        # `Remv <pkg>` for ones it merely removes — the first version of this
        # matched only /^Remv / and was therefore blind to half of what apt was
        # about to do. Match both.
        removed=$(DEBIAN_FRONTEND=noninteractive apt-get -s purge -y "$p" 2>/dev/null \
                    | awk '/^(Remv|Purg) /{print $2}')
        # Log the full cascade. The first version sent apt's output to /dev/null,
        # so when this hook deleted the entire desktop there was no record of
        # WHICH package took it — the build log showed only the successful
        # purges. Never discard this again.
        n_removed=$(printf '%s\n' "$removed" | grep -c . || true)
        if [ "${n_removed:-0}" -gt 1 ]; then
            echo "debloat: purging $p would also remove ${n_removed} package(s):"
            printf '%s\n' "$removed" | sed 's/^/debloat:     /'
        fi
        if printf '%s\n' "$removed" | grep -qE "$GUARD"; then
            echo "debloat: KEEPING $p — purging it would also remove:" >&2
            printf '%s\n' "$removed" | grep -E "$GUARD" | sed 's/^/debloat:     /' >&2
            continue
        fi
        sz=$(awk -v pkg="$p" '
            /^Package: /{ p=$2 } /^Installed-Size: /{ if (p==pkg) { print $2; exit } }
        ' /var/lib/dpkg/status 2>/dev/null || echo 0)
        if DEBIAN_FRONTEND=noninteractive apt-get purge -y "$p" >/dev/null 2>&1; then
            purged_kb=$((purged_kb + ${sz:-0}))
            echo "debloat: purged $p (${sz:-?} KB)"
        else
            echo "debloat: could not purge $p — left in place." >&2
        fi
    done
}

# 1) CANONICAL SERVICE LAYER. ubuntu-pro-client is the important one: it is not
#    merely unused, it ADVERTISES. A live boot's own MOTD printed
#      "Expanded Security Maintenance for Applications is not enabled."
#      "Enable ESM Apps ... See https://ubuntu.com/esm or run: sudo pro status"
#    inside Refract OS, despite 0200-refract-identity.chroot disabling the stock
#    MOTD scripts — pro installs its own. That is both bloat and an Ubuntu
#    branding leak in a distro whose whole identity layer exists to remove them.
#    whoopsie and apport ship crash data to Canonical from a machine whose owner
#    never opted in; neither has any function in this OS.
try_purge ubuntu-pro-client ubuntu-advantage-tools whoopsie apport

# 2) ASSETS THIS DISTRO REPLACED BUT KEPT PAYING FOR. Yaru's icon theme is dead
#    weight now that MacTahoe ships as the default icon theme, and Ubuntu's
#    wallpapers are dead weight next to branding/make-wallpapers.py's set. Both
#    are guarded above: if the desktop metapackage genuinely depends on either,
#    the purge is refused rather than silently shipping a broken desktop.
try_purge yaru-theme-icon ubuntu-wallpapers-noble ubuntu-wallpapers

# 3) LEFTOVER BUILD TOOLING. 0410-keyd.chroot compiles keyd from source and then
#    purges "gcc make" — but `gcc` is only the metapackage, so the actual
#    compiler survived: the shipped image still carried gcc-13-x86-64-linux-gnu
#    (61 MB) and cpp-13-x86-64-linux-gnu (31 MB). Nothing on a desktop image
#    needs a C compiler at runtime.
try_purge gcc-13-x86-64-linux-gnu cpp-13-x86-64-linux-gnu

# 4) UNUSED SPEECH DATA. pocketsphinx-en-us (37 MB) is an offline acoustic model
#    pulled in transitively; nothing in this OS does speech recognition.
try_purge pocketsphinx-en-us

# 5) FIREFOX + SNAPD. The project owner chose Google Chrome as the default
#    browser, installed as a real .deb from Google's apt repo by
#    0450-chrome.chroot. With Chrome present, Firefox has no reason to ship —
#    and because Ubuntu's Firefox is a SNAP, removing it also lets snapd go
#    (129 MB, plus its mount units and the sluggish first-launch that is the
#    single most common thing people call bloat on an Ubuntu derivative).
#
#    STRICTLY CONDITIONAL. 0450 writes /etc/refract-chrome-installed only when
#    google-chrome-stable is genuinely on disk. If Chrome failed to install (a
#    network hiccup fetching Google's key, say), this is skipped entirely rather
#    than shipping an image with NO browser at all — which would be a far worse
#    outcome than a little bloat.
if [ -e /etc/refract-chrome-installed ] && [ -x /usr/bin/google-chrome-stable ]; then
    try_purge firefox snapd
    # snapd leaves its state behind; without this the space is not actually
    # reclaimed and the empty mount points linger on the installed system.
    rm -rf /var/lib/snapd /var/cache/snapd /snap 2>/dev/null || true
    echo "debloat: Firefox and snapd removed (Chrome is the browser)."
else
    echo "debloat: KEEPING firefox and snapd — Chrome is not installed, so removing" >&2
    echo "debloat:   Firefox would leave this image with no browser at all." >&2
fi

# DELIBERATELY NOT TOUCHED, and why — each is a product decision, not a cleanup:
#   cups             — printing is a real feature a desktop is expected to have.
#   ibus-data        — input methods; removing it breaks typing in non-Latin
#                      scripts. Size is not a good enough reason to break i18n.
#   libllvm18/19/20  — three copies is genuinely suspect, but mesa links one of
#                      them and getting this wrong breaks graphics. Needs a real
#                      dependency trace, not a guess.
#   unattended-upgrades — security updates. Bloat is not a reason to stop
#                      patching a machine.

echo "debloat: reclaimed approximately $((purged_kb / 1024)) MB."

# ┌─ REFRACT PRISM · BAND 3 of 7 · YELLOW ─────────────────────────────────────┐
# │ Here lies the entire GNOME desktop, removed 2026-08-12, 331 MB lighter and │
# │ completely gone. Cause of death: `ubuntu-wallpapers`, which quietly        │
# │ cascades to gnome-shell and gdm3. The guard below was watching — it just   │
# │ matched `Remv` and apt had written `Purg`. One word, whole desktop.        │
# │ Then verification PASSED the corpse, because a missing gnome-shell reads   │
# │ as "headless strain, skip the GNOME checks". Nothing caught it. A human    │
# │ looked at a screenshot. That is the entire detection story.                │
# │ Band 3 of 7. Assertions about the OUTCOME, not the plan. Hence what follows│
# └────────────────────────────────────────────────────────────────────────────┘
# POST-PURGE SAFETY NET — the whole reason this exists.
# The first version of this hook removed the ENTIRE GNOME desktop: a workstation
# image came out with no /usr/bin/gnome-shell, booting to a tty1 login prompt.
# Worse, verify-boot-fixes detects the desktop FROM the image, so a missing
# desktop read as "headless strain" and it SKIPPED every GNOME assertion and
# reported success. Nothing anywhere caught it; it was found by looking at a
# screenshot.
#
# A guard that only inspects apt's simulation is not enough — it evidently
# missed this. So assert the OUTCOME: if this image had a desktop before the
# purges, it must still have one after. Failing the build is strictly better
# than shipping an ISO that boots to a text prompt.
if [ -n "${HAD_DESKTOP:-}" ]; then
    missing=""
    [ -x /usr/bin/gnome-shell ] || missing="$missing gnome-shell"
    [ -x /usr/sbin/gdm3 ] || [ -x /usr/bin/gdm3 ] || missing="$missing gdm3"
    if [ -n "$missing" ]; then
        echo "debloat: FATAL — the purges above destroyed the desktop. Missing:$missing" >&2
        echo "debloat: refusing to ship a desktop image that boots to a text console." >&2
        exit 1
    fi
    echo "debloat: desktop intact after purge (gnome-shell + gdm3 present)."
fi
