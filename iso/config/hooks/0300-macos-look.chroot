#!/bin/sh
# Refract OS macOS look — WhiteSur GTK + icon themes SYSTEM-WIDE + the Blur-my-Shell
# extension (the frosted "liquid glass" used by Normal mode). Runs in the chroot
# AS ROOT — which matters: WhiteSur's installer writes temp assets that fail as a
# non-root user (that's why it silently no-op'd on bare CI runners). Failure-
# tolerant: these are cosmetic, so a hiccup logs and the ISO still builds (the
# desktop just falls back to dark Yaru / no blur).
#
# Pinned upstream commits (fetch-by-SHA, verified before use):
GTK_SHA="a83f467e4c16b1ed1c960f3d89e2472d9639477c"   # vinceliuice/WhiteSur-gtk-theme
ICON_SHA="db9a4f8b236d3c559326f041d75d5173de118c45"  # vinceliuice/MacTahoe-icon-theme (macOS 26 Liquid Glass)
BMS_SHA="c9002511c7c8ad65931e3f875fe0ea93b8123394"   # aunetx/blur-my-shell

# WHY THIS EXPORT IS LOAD-BEARING — it is the whole reason the macOS look never
# shipped. WhiteSur's install.sh sources libs/lib-install.sh -> libs/lib-core.sh,
# which begins `set -Eeo pipefail` and then, before printing anything:
#
#     MY_USERNAME="${SUDO_USER:-$(logname 2> /dev/null || echo "${USER}")}"
#     MY_HOME=$(getent passwd "${MY_USERNAME}" | cut -d: -f6)
#
# Inside a live-build chroot there is no SUDO_USER, `logname` fails (no
# controlling terminal, no utmp), and USER is not exported — so MY_USERNAME is
# the EMPTY STRING. `getent passwd ""` matches no key and exits 2, and with
# errexit+pipefail that kills the installer instantly, at source time, before a
# single line of its own output. That is the silent ~27ms failure: the log showed
# "installing WhiteSur GTK..." and then nothing, the `script -qfec` fallback died
# the same way for the same reason, and every image shipped WhiteSur ICONS (whose
# installer does not use these libs, which is exactly why icons always worked)
# with NO WhiteSur GTK theme — while the schema/dconf defaults below still named
# 'WhiteSur-Dark'. A desktop asking for a theme that was never installed silently
# renders as stock Adwaita, which is why the "macOS look" was never visible.
export USER=root LOGNAME=root HOME=/root

command -v git >/dev/null 2>&1 || { echo "macos-look: git missing — skipping."; exit 0; }
WORK="$(mktemp -d)"
# shellcheck disable=SC2064
trap "rm -rf '$WORK'" EXIT INT TERM

clone_pin() {  # url sha dir
    git init -q "$3" 2>/dev/null || return 1
    git -C "$3" remote add origin "$1" 2>/dev/null || return 1
    if ! git -C "$3" fetch -q --depth 1 origin "$2" 2>/dev/null; then
        echo "macos-look: fetch failed for $1@$2 (network?) — skipping it." >&2; return 1
    fi
    git -C "$3" checkout -q FETCH_HEAD 2>/dev/null || return 1
    [ "$(git -C "$3" rev-parse HEAD 2>/dev/null)" = "$2" ] || { echo "macos-look: $1 sha mismatch — refusing." >&2; return 1; }
}

# --- WhiteSur GTK: install to a temp dir (NOT a system dir → avoids the script's
#     internal sudo path), then copy in. stderr is intentionally VISIBLE now. ---
if clone_pin https://github.com/vinceliuice/WhiteSur-gtk-theme.git "$GTK_SHA" "$WORK/ws-gtk"; then
    echo "macos-look: installing WhiteSur GTK + GNOME Shell theme..."
    mkdir -p "$WORK/ws-out"
    # --silent-mode is REQUIRED here, not cosmetic. lib-core.sh's start_animation()
    # runs `setterm -cursor off` to hide the cursor behind its spinner, and setterm
    # needs a real terminal — which a live-build chroot with stdout on a log file
    # does not have. Under the installer's own `set -Eeo pipefail` that kills it
    # instantly, immediately after it prints its settings banner and before it
    # installs anything, with no error of its own. This is the SECOND of two
    # environment landmines in this installer; the first was the empty $USER
    # tripping `getent passwd ""`, fixed by the export at the top of this hook.
    # Fixing only that one got the banner to print and nothing else.
    #
    # --silent-mode is upstream's own non-interactive path: it early-returns from
    # start_animation/stop_animation and every other cursor-and-prompt routine.
    # Its full_sudo() check only tests that /root is writable, which it is here.
    # The old `script -qfec` pseudo-TTY fallback is gone — it failed identically,
    # because the problem was never the absence of a pty.
    if bash "$WORK/ws-gtk/install.sh" --silent-mode -d "$WORK/ws-out" 2>&1; then
        :
    else
        # Do not guess a third time. Re-run under a shell trace and print the tail,
        # so the build log names the exact command that failed instead of leaving
        # another silent death to be reverse-engineered from upstream source.
        echo "macos-look: WhiteSur GTK install failed — re-running traced to identify the failing command." >&2
        bash -x "$WORK/ws-gtk/install.sh" --silent-mode -d "$WORK/ws-out" >"$WORK/ws-trace.log" 2>&1 || true
        echo "--- last 40 lines of the traced WhiteSur run ---" >&2
        tail -n 40 "$WORK/ws-trace.log" >&2 || true
        echo "--- end trace (desktop falls back to an installed theme, see below) ---" >&2
    fi
    cp -a "$WORK/ws-out/." /usr/share/themes/ 2>/dev/null || true
fi

# --- MacTahoe icons: the macOS 26 (Tahoe) "Liquid Glass" icon set. ---
# Replaces WhiteSur's icons, which are the Big Sur look from 2020. Same author
# (vinceliuice), so the install interface matches what this hook already drives.
# Unlike the WhiteSur GTK installer next door, install.sh here is self-contained
# — `set -eo pipefail` with NO sourced lib — so it has neither of the two
# landmines that kept the GTK theme from ever shipping (the empty-$USER
# `getent passwd ""` trip, and start_animation's `setterm` needing a TTY). It
# needs only cp/sed/ln/mkdir/mv/rm and gtk-update-icon-cache, all present here.
#
# Installs MacTahoe, MacTahoe-light and MacTahoe-dark (default/blue variant).
# The desktop defaults name MacTahoe-dark; keep those in sync — a name that does
# not exist on disk is the "phantom theme" failure that hid the missing GTK
# theme for months, and verify-boot-fixes now asserts against exactly that.
if clone_pin https://github.com/vinceliuice/MacTahoe-icon-theme.git "$ICON_SHA" "$WORK/mt-icon"; then
    echo "macos-look: installing MacTahoe (macOS 26 Liquid Glass) icon theme..."
    "$WORK/mt-icon/install.sh" -d /usr/share/icons \
        || echo "macos-look: icon installer returned non-zero (continuing)." >&2
fi

# --- Blur-my-Shell (glass): NOT in apt, and `make build` needs tooling the chroot
#     lacks — so assemble the extension by hand from the repo layout
#     (src/{extension,prefs}.js + metadata.json + schemas/ + resources/). ---
if clone_pin https://github.com/aunetx/blur-my-shell.git "$BMS_SHA" "$WORK/bms"; then
    echo "macos-look: installing Blur-my-Shell (liquid glass)..."
    EXTD=/usr/share/gnome-shell/extensions/blur-my-shell@aunetx
    mkdir -p "$EXTD"
    cp -a "$WORK/bms/src/." "$EXTD/" 2>/dev/null || true
    cp -a "$WORK/bms/metadata.json" "$EXTD/" 2>/dev/null || true
    # gnome-extensions pack copies resources/{icons,ui} to the extension root.
    [ -d "$WORK/bms/resources/icons" ] && cp -a "$WORK/bms/resources/icons" "$EXTD/" 2>/dev/null || true
    [ -d "$WORK/bms/resources/ui" ]    && cp -a "$WORK/bms/resources/ui"    "$EXTD/" 2>/dev/null || true
    if [ -d "$WORK/bms/schemas" ]; then
        cp -a "$WORK/bms/schemas" "$EXTD/"
        command -v glib-compile-schemas >/dev/null 2>&1 && glib-compile-schemas "$EXTD/schemas" 2>/dev/null || true
    fi
    [ -f "$EXTD/extension.js" ] && echo "macos-look: Blur-my-Shell assembled." \
        || echo "macos-look: Blur-my-Shell assemble incomplete — Normal mode has no glass." >&2
fi

# BLANK the Ubuntu "swirl" (start-here / ubuntu-logo) INSIDE the freshly
# installed MacTahoe icon themes — the 0200 identity hook ran before WhiteSur
# existed, so it couldn't reach these. $_CL/$_SVG are transparent 1x1 stand-ins
# (see iso/build.sh): the OS ships no Refract mark, and leaving these untouched
# would leave the theme's own Ubuntu swirl showing instead.
_CL=/usr/share/refract/logo.png; _SVG=/usr/share/refract/logo.svg
for _n in start-here ubuntu-logo distributor-logo; do
    find /usr/share/icons/MacTahoe /usr/share/icons/MacTahoe-dark -type f -iname "${_n}.png" \
        -exec cp "$_CL" {} \; 2>/dev/null || true
    [ -f "$_SVG" ] && find /usr/share/icons/MacTahoe /usr/share/icons/MacTahoe-dark -type f -iname "${_n}.svg" \
        -exec cp "$_SVG" {} \; 2>/dev/null || true
done
for t in MacTahoe MacTahoe-dark; do
    [ -d "/usr/share/icons/$t" ] && command -v gtk-update-icon-cache >/dev/null 2>&1 \
        && gtk-update-icon-cache -qf "/usr/share/icons/$t" 2>/dev/null || true
done

if [ -d /usr/share/themes/WhiteSur-Dark ]; then
    echo "macos-look: WhiteSur-Dark GTK present — default desktop renders macOS-style."
else
    # Do not leave the defaults naming a theme that isn't installed. The glib
    # override and the dconf db both hardcode gtk-theme='WhiteSur-Dark'; when the
    # install fails, GTK silently falls back to Adwaita, so the desktop renders as
    # stock GNOME while every config file, mode profile and doc insists it is
    # macOS-styled. (The old message here claimed the fallback was "dark Yaru" —
    # it never was; nothing pointed at Yaru.) Repoint the default at a theme that
    # actually exists so the degraded state is coherent and legible.
    echo "macos-look: WhiteSur-Dark GTK MISSING — repointing desktop defaults at an installed theme." >&2
    _fb=""
    for _c in Yaru-dark Adwaita-dark Adwaita; do
        [ -d "/usr/share/themes/$_c" ] && { _fb="$_c"; break; }
    done
    if [ -n "$_fb" ]; then
        for _f in /usr/share/glib-2.0/schemas/99_refract.gschema.override \
                  /etc/dconf/db/local.d/00-refract; do
            [ -f "$_f" ] && sed -i "s/'WhiteSur-Dark'/'$_fb'/g" "$_f" 2>/dev/null || true
        done
        command -v glib-compile-schemas >/dev/null 2>&1 && glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
        command -v dconf >/dev/null 2>&1 && dconf update 2>/dev/null || true
        echo "macos-look: desktop gtk/shell theme default is now '$_fb'." >&2
    else
        echo "macos-look: no fallback theme found either — defaults left as-is." >&2
    fi
fi
exit 0
