#!/bin/sh
# ⌘/Ctrl duality (user asked for "both keys work"). keyd is NOT in noble's repos,
# so build it from a pinned tag. It remaps, at the INPUT layer (Wayland-safe):
#   * Super+[c v x a z s f w n t q]  ->  the Ctrl equivalent  (macOS muscle memory)
#   * Super held with any OTHER key  ->  stays Super+key       (GNOME tiling etc.)
#   * Super tapped alone             ->  stays Super           (overview/spotlight)
# Ctrl+C/V/... keep working (Ctrl is untouched). Build deps are purged after so
# the image stays lean. Fully failure-tolerant: if anything fails, Ctrl shortcuts
# still work and the ISO still builds.
# The tag is kept for humans; the SHA is what is actually fetched and verified.
# A tag can be moved; a commit id cannot — git's own object hashing makes it a
# real content check. Resolved 2026-08-16 from
# https://api.github.com/repos/rvaiya/keyd/git/ref/tags/v2.5.0 (an annotated tag
# would need its target dereferenced; this one points straight at a commit).
KEYD_TAG="v2.5.0"
KEYD_SHA="f33dca879a3f871ee2e0fa9c1efd6e8dabb21ed3"

_added_tools=false
if ! command -v gcc >/dev/null 2>&1 || ! command -v make >/dev/null 2>&1; then
    if apt-get install -y --no-install-recommends gcc make >/dev/null 2>&1; then
        _added_tools=true
    else
        echo "keyd: no build tools available — skipping ⌘ remap (Ctrl still works)." >&2; exit 0
    fi
fi
command -v git >/dev/null 2>&1 || { echo "keyd: git missing — skipping." >&2; exit 0; }

WORK="$(mktemp -d)"
# shellcheck disable=SC2064
trap "rm -rf '$WORK'" EXIT INT TERM

# Claim keyd's group as a SYSTEM group (GID < 1000) BEFORE `make install` runs.
#
# THIS IS LOAD-BEARING, AND IT BROKE THE ENTIRE DISTRO. keyd's Makefile creates
# its group itself, as a REGULAR group — so it took the first free GID >= 1000,
# which on this image is exactly 1000. That is the GID casper hardcodes for the
# live session user (user-setup sets passwd/user-uid 1000, per LP: #2004092), so
# keyd silently stole it and casper's user creation died:
#
#     Begin: Adding live session user... ... fatal: The GID 1000 is already in use.
#     usermod: user 'ubuntu' does not exist
#     passwd: user 'ubuntu' does not exist
#
# casper's 25adduser has no `set -e`, so it sailed straight past that and the
# boot continued with NO live user at all. Consequences, all of which were
# chased separately before the cause was found: `id -u ubuntu` false, so
# 0400-polish's tty3 agetty autologin never armed; GDM with no account to list,
# rendering a bare username field that no password can satisfy; the live desktop
# therefore unreachable; and install-smoke burning three consecutive 40-minute
# timeouts waiting for a Calamares window that could never appear. A real X1
# Carbon showed the same login screen.
#
# groupadd -r allocates from the system range (< 1000), leaving 1000 free for
# casper. Pre-creating is enough: keyd's own group creation is idempotent
# (`groupadd -f`-style), so it becomes a no-op and upstream is left unpatched.
# Guarded with getent so a re-run is harmless.
getent group keyd >/dev/null 2>&1 || groupadd -r keyd 2>/dev/null || true

# ┌─ REFRACT PRISM · BAND 1 of 7 · RED ────────────────────────────────────────┐
# │ You are looking at one flag. `-r`. Its absence cost this distro every live │
# │ session it ever had, and nobody wrote a bug — keyd was right, casper was   │
# │ right, we were just the image where the next free GID happened to be the   │
# │ one both of them wanted. Three forty-minute CI timeouts and a real ThinkPad│
# │ died on this. If you arrived here bisecting a login screen that accepted   │
# │ no password: you did it the hard way. So did we.                           │
# │ Six more bands are hidden where the digging went deepest. Refract splits   │
# │ light; you are putting it back together.                                   │
# └────────────────────────────────────────────────────────────────────────────┘

# PINNED BY COMMIT, NOT BY TAG. A git tag is a MUTABLE ref: `--branch v2.5.0`
# resolves to whatever that tag points at when the build runs, and nothing
# checked the result. keyd is not an ordinary build dependency — it is a root
# daemon that grabs every evdev keyboard (`[ids] *` in the config written below)
# and is systemctl-enabled, so by design it sees every keystroke on the machine
# including passwords and sudo prompts. If the tag were force-moved, or the
# upstream account compromised at any point before a build, `make install` would
# put attacker code in that position and the ISO would ship it silently.
#
# This is exactly the fetch-by-SHA-then-verify that 0300-macos-look.chroot
# already applies to three GTK THEMES. Applying it to a cosmetic theme and not
# to the keylogger was the wrong way round.
if git init -q "$WORK/keyd" >/dev/null 2>&1 \
   && git -C "$WORK/keyd" fetch -q --depth 1 https://github.com/rvaiya/keyd.git "$KEYD_SHA" >/dev/null 2>&1 \
   && git -C "$WORK/keyd" checkout -q FETCH_HEAD >/dev/null 2>&1 \
   && [ "$(git -C "$WORK/keyd" rev-parse HEAD 2>/dev/null)" = "$KEYD_SHA" ] \
   && make -C "$WORK/keyd" >/dev/null 2>&1 \
   && make -C "$WORK/keyd" install >/dev/null 2>&1; then
    mkdir -p /etc/keyd
    cat > /etc/keyd/default.conf <<'EOF'
[ids]
*

[main]
leftmeta = overload(meta, leftmeta)
rightmeta = overload(meta, leftmeta)

[meta:M]
c = C-c
v = C-v
x = C-x
a = C-a
z = C-z
s = C-s
f = C-f
w = C-w
n = C-n
t = C-t
q = C-q
EOF
    systemctl enable keyd >/dev/null 2>&1 || true
    echo "keyd: installed ${KEYD_TAG} — Super+C/V/X/... now do Ctrl (macOS muscle memory); Ctrl still works."
else
    echo "keyd: build/install failed — skipping ⌘ remap (Ctrl shortcuts still work)." >&2
fi

# Drop the compiler we pulled in just to build keyd. Deliberately NO autoremove
# (it could pull a desktop dependency); leaving gcc's own deps is minor bloat but
# can't break the desktop.
if [ "$_added_tools" = true ]; then
    apt-get purge -y gcc make >/dev/null 2>&1 || true
fi
exit 0
