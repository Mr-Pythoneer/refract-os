#!/bin/sh
#
# Casper-bottom hook: drops the "Install Refract OS" launcher onto the live
# user's Desktop during live boot. This is the same documented mechanism
# real live-build+Calamares distros use (verified against
# maui-linux/calamares-casper's casper-bottom/25calamares script, fetched
# and read directly rather than guessed) -- casper-bottom scripts under
# /usr/share/initramfs-tools/scripts/casper-bottom/ only ever run as part of
# casper's live-boot initramfs sequence, so this never needs a separate
# "am I running live?" check: an installed system never executes this script
# at all, it only exists inside the live initrd.
#
# build.sh only copies this file in for GUI strains (the same ones that get
# Calamares wired in at all) -- see iso/build.sh's HEADLESS_STRAINS check.

# MUST run after casper's own 25adduser: initramfs-tools orders casper-bottom
# scripts by tsort over PREREQ, falling back to glob order, and under the C
# locale mkinitramfs runs with, "25-refract-install-icon" sorts BEFORE
# "25adduser" ('-' is 0x2D, 'a' is 0x61). Without this the hook ran first,
# $USERNAME was still empty, the [ -n "$USERNAME" ] guard short-circuited, and
# the Desktop launcher was silently never created.
PREREQ="25adduser"
DESCRIPTION="Adding Refract OS install icon to live session user..."

prereqs()
{
    echo "$PREREQ"
}

case $1 in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /scripts/casper-functions
load_confmodule

log_begin_msg "$DESCRIPTION"

DESKTOP_FILE=/usr/share/applications/install-refract-os.desktop
if [ -f "/root$DESKTOP_FILE" ] && [ -n "$USERNAME" ]; then
    chroot /root install -d -o "$USERNAME" -g "$USERNAME" "/home/$USERNAME/Desktop"
    chroot /root install -D -o "$USERNAME" -g "$USERNAME" "$DESKTOP_FILE" "/home/$USERNAME/Desktop/$(basename "$DESKTOP_FILE")"
    # Mark it trusted + executable, or GNOME renders it as an UNTRUSTED launcher:
    # the raw filename "install-refract-os.desktop" under a generic icon with a red
    # X badge, which does nothing useful on a double-click. Confirmed visually in
    # install-smoke run 31510234422's 00-desktop screenshot, the first run that
    # ever reached a live desktop. casper's own 25adduser does exactly this for
    # ubiquity's launcher (`gio set ... metadata::trusted true`) — this hook copied
    # the file but never inherited that step, so the icon has always been broken.
    # dbus-run-session because gio needs a session bus, and gio is only meaningful
    # if both binaries exist in the image; guarded so a missing one is not fatal.
    chroot /root chmod +x "/home/$USERNAME/Desktop/$(basename "$DESKTOP_FILE")" 2>/dev/null || true
    if [ -x /root/usr/bin/dbus-run-session ] && [ -x /root/usr/bin/gio ]; then
        chroot /root sudo -i -u "$USERNAME" dbus-run-session -- \
            gio set "/home/$USERNAME/Desktop/$(basename "$DESKTOP_FILE")" \
            metadata::trusted true 2>/dev/null || true
    fi
fi

# LIVE AUTOLOGIN — without this the ISO boots to a GDM prompt nobody can get
# past. casper's live user has NO PASSWORD (the polkit block below depends on
# exactly that), so the greeter asks for a credential that does not exist.
#
# This is not a theory. install-smoke run 31477983073 uploaded its evidence
# shots: 00-desktop.ppm is a GDM "Username" field and 01c-after-launch.ppm is a
# GDM "Password" field — the harness was typing its app-search keystrokes into
# the login form. The installer never appeared, so the job burned its entire
# 40-minute timeout waiting for a window that could not exist, twice, and was
# recorded as "cancelled" both times. It is also precisely what a real X1
# Carbon showed ("it still goes to that old login screen").
#
# Ubuntu's casper only configures GDM autologin when /etc/gdm3/custom.conf
# ALREADY exists; writing the file ourselves removes that dependency instead of
# betting on it. Both custom.conf (Ubuntu's gdm3) and daemon.conf (Debian's) are
# written because the unused one is inert, and a single guess is how this
# silently no-ops. Live-only by construction: an installed system never runs a
# casper-bottom script, so autologin cannot leak onto a real install — the same
# containment that makes the polkit grant below safe.
if [ -n "$USERNAME" ] && [ -d /root/etc ]; then
    for f in /root/etc/gdm3/custom.conf /root/etc/gdm3/daemon.conf; do
        mkdir -p "$(dirname "$f")"
        [ -f "$f" ] || printf '[daemon]\n' > "$f"
        grep -q '^\[daemon\]' "$f" || printf '[daemon]\n' >> "$f"
        for kv in "AutomaticLoginEnable=true" "AutomaticLogin=$USERNAME"; do
            k="${kv%%=*}"
            if grep -q "^${k}=" "$f"; then
                sed -i "s|^${k}=.*|${kv}|" "$f"
            else
                sed -i "/^\[daemon\]/a ${kv}" "$f"
            fi
        done
    done
fi

# Passwordless polkit grant for the LIVE installer only. The launcher is
# `pkexec calamares`, and the live `ubuntu` user has no password, so without a
# grant the installer can never launch (or manage disks / reboot). This rule
# USED to be baked into the squashfs (config/includes.chroot) — which meant it
# ALSO landed on every installed system, where any local desktop user could then
# `pkexec bash` for a passwordless root shell (the "subject.local && active"
# scope matches the installed user too, and nothing removed it). Writing it here,
# from casper-bottom, keeps it in the LIVE overlay only: an installed system
# never runs this hook, so the rule cannot persist. Scope is disk (udisks2),
# the installer's own action, generic pkexec (for the `pkexec calamares`
# launcher), and reboot (login1) — all fine in an ephemeral live session.
if [ -d /root/etc ]; then
    mkdir -p /root/etc/polkit-1/rules.d
    cat > /root/etc/polkit-1/rules.d/49-refract-installer.rules <<'POLKIT'
polkit.addRule(function(action, subject) {
    if (subject.local && subject.active &&
        (action.id.indexOf("org.freedesktop.udisks2.") === 0 ||
         action.id.indexOf("com.github.calamares.") === 0 ||
         action.id === "org.freedesktop.policykit.exec" ||
         action.id.indexOf("org.freedesktop.login1.") === 0)) {
        return polkit.Result.YES;
    }
});
POLKIT
    chmod 0644 /root/etc/polkit-1/rules.d/49-refract-installer.rules
fi

log_end_msg
