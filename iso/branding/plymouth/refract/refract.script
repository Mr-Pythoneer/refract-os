# Refract OS Plymouth splash — TEXT ONLY, no logo image.
#
# Deliberately logo-free: the OS ships no Refract mark anywhere, so the splash
# draws the product name as text and the boot messages beneath it, on the same
# near-black the wallpapers and installer use. Still minimal (no external bar or
# dot images) so it cannot fail to load, and now it cannot fail to FIND an image
# either — there is no Image() call at all.
Window.SetBackgroundTopColor(0.043, 0.043, 0.051);
Window.SetBackgroundBottomColor(0.043, 0.043, 0.051);

# Product name, centred slightly above the middle where the mark used to sit.
title.image  = Image.Text("Refract OS", 0.92, 0.92, 0.94);
title.sprite = Sprite(title.image);
title.sprite.SetX(Window.GetWidth()  / 2 - title.image.GetWidth()  / 2);
title.sprite.SetY(Window.GetHeight() / 2 - title.image.GetHeight() / 2 - 10);

# boot / status messages just below the title
msg.sprite = Sprite();
msg.sprite.SetPosition(0, Window.GetHeight() / 2 + title.image.GetHeight() / 2 + 14, 100);
fun message_cb(text) {
    msg.image = Image.Text(text, 0.85, 0.85, 0.85);
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetX(Window.GetWidth() / 2 - msg.image.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_cb);
